{
  "name": "electron-solid-starter",
  "version": "0.1.0",
  "description": "Starter Electron Forge + Vite project preconfigured with Solid and Solid Router.",
  "type": "module",
  "main": "src/main/index.ts",
  "scripts": {
    "start": "electron-forge start",
    "dev": "npm run start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint src --max-warnings 0",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt \"src/**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,js,jsx,json,css,html}\""
  },
  "keywords": [
    "electron",
    "solidjs",
    "vite",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "electron": "^39.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@types/node": "^24.10.0",
    "oxfmt": "^0.11.0",
    "oxlint": "^1.26.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-solid": "^2.11.10"
  }
}
