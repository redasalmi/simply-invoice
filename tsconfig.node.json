{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/db/**/*",
    "src/types.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@db/*": ["src/db/*"],
      "@resources/*": ["resources/*"],
      "@main/*": ["src/main/*"],
      "@types": ["src/types.ts"]
    }
  }
}
