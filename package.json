{
	"name": "electron-solid-app",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:electron": "tsc -p tsconfig.node.json",
		"build:all": "npm run build && npm run build:electron",
		"preview": "vite preview",
		"electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
		"electron:build": "npm run build:all && electron-builder",
		"lint": "oxlint",
		"format": "oxc format --write",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@solidjs/router": "^0.11.2",
		"solid-js": "^1.9.2"
	},
	"devDependencies": {
		"@oxc/cli": "^0.20.0",
		"@types/node": "^22.10.2",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"electron": "^33.2.1",
		"electron-builder": "^25.1.8",
		"oxlint": "^0.20.0",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.14",
		"typescript": "^5.7.2",
		"vite": "^6.0.5",
		"vite-plugin-solid": "^2.10.1",
		"wait-on": "^8.0.1"
	},
	"main": "dist-electron/main.js"
}
